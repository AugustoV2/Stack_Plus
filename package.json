{
  "name": "stackpulse",
  "version": "1.0.0",
  "description": "StackPulse - Developer Intelligence & Comparison Platform",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build && npm --prefix server run build",
    "start": "npm --prefix server run start"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.11.1",
    "@types/pg": "^8.16.0",
    "concurrently": "^9.2.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}

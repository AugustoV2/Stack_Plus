# StackPulse Server Environment Configuration

PORT=5000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET=stackpulse_secure_jwt_token_secret_key_2026_x89a

# Optional: GitHub Personal Access Token
# Unauthenticated requests are limited to 60/hr.
# Adding a token increases your rate limit to 5,000/hr.
GITHUB_TOKEN=

# Optional: PostgreSQL Database Connection URL
# StackPulse connects to PostgreSQL if provided, or automatically uses
# the resilient embedded database fallback if PostgreSQL is not running.
# Example: postgresql://postgres:password@localhost:5432/stackpulse
DATABASE_URL=
